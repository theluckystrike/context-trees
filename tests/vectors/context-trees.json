     "    * Mix the <<dough>>"
    ],
    "hits": 1
   }
  },
  {
   "name": "a second list does not inherit the first list items",
   "args": [
    "# Lists\n\n- first\n  - first child\n\nplain paragraph\n\n- second\n  - target here\n",
    "target"
   ],
   "expected": {
    "outline": [
     "- # Lists",
     "  - second",
     "    * <<target>> here"
    ],
    "hits": 1
   }
  },
  {
   "name": "a hit before the first heading has no heading path",
   "args": [
    "intro with needle\n\n# Later\n",
    "needle"
   ],
   "expected": {
    "outline": [
     "* intro with <<needle>>"
    ],
    "hits": 1
   }
  },
  {
   "name": "continuation line of an item shows under the item",
   "args": [
    "# Note\n\n- Parent item\n  continues with needle here\n",
    "needle"
   ],
   "expected": {
    "outline": [
     "- # Note",
     "  - Parent item",
     "    * continues with <<needle>> here"
    ],
    "hits": 1
   }
  },
  {
   "name": "hit on a parent item and on its child",
   "args": [
    "# Note\n\n- Alpha parent\n  - Alpha child\n",
    "alpha"
   ],
   "expected": {
    "outline": [
     "- # Note",
     "  * <<Alpha>> parent",
     "    * <<Alpha>> child"
    ],
    "hits": 2
   }
  },
  {
   "name": "tab indented lists",
   "args": [
    "# Note\n\n- One\n\t- Two\n\t\t- Three target\n",
    "target"
   ],
   "expected": {
    "outline": [
     "- # Note",
     "  - One",
     "    - Two",
     "      * Three <<target>>"
    ],
    "hits": 1
   }
  },
  {
   "name": "unicode text",
   "args": [
    "# Zażółć\n\n- Gęślą jaźń\n",
    "jaźń"
   ],
   "expected": {
    "outline": [
     "- # Zażółć",
     "  * Gęślą <<jaźń>>"
    ],
    "hits": 1
   }
  },
  {
   "name": "empty query gives nothing",
   "args": [
    "# Note\n\ntext\n",
