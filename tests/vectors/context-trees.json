{
 "slug": "context-trees",
 "module": "context-trees/src/reference",
 "function": "trees",
 "note": "args = [Markdown text, query text, options {regex, caseSensitive}]; expected = {outline, hits}. outline has one line for each tree node, indented by depth: '*' marks a hit, '-' a context line, headings start with their # signs and hits are wrapped in <<>>. Expected values are written by hand. A hit counts one for each matching line. Only the fields present are compared. Wiki links show their names or aliases; a hit in a hidden target marks the visible label. With options.unlinked true, the query text is the note name and the hits are unlinked mentions: text in links, Markdown links, URLs, tags, inline code, fenced code (unless codeBlocks), front matter and ignored terms does not count.",
 "cases": [
  {
   "name": "Markdown link label marks a hidden target match",
   "args": [
    "# Links\nPlan [港](資料/Plan.md)\n",
    "Plan"
   ],
   "expected": {
    "outline": [
     "- # Links",
     "  * <<Plan>> <<港>>"
    ],
    "hits": 1
   }
  },
  {
   "name": "paragraph hit shows the heading path",
   "args": [
    "# Trip\n\n## Food\n\nWe ate noodles at the market.\n\n## Hotels\n\nNo match here.\n",
    "noodles"
   ],
   "expected": {
    "outline": [
     "- # Trip",
     "  - ## Food",
     "    * We ate <<noodles>> at the market."
    ],
    "hits": 1
   }
  },
  {
   "name": "list hit shows heading and parent items",
   "args": [
    "# Plan\n\n- Launch\n  - Docs\n    - Write the guide\n    - Review the guide\n  - Site\n",
    "write"
   ],
   "expected": {
    "outline": [
     "- # Plan",
     "  - Launch",
     "    - Docs",
     "      * <<Write>> the guide"
    ],
    "hits": 1
   }
  },
  {
   "name": "two hits under one parent share the parent",
   "args": [
    "# Plan\n\n- Launch\n  - Write the guide\n  - Write the FAQ\n  - Ship\n",
    "write"
   ],
   "expected": {
    "outline": [
     "- # Plan",
     "  - Launch",
     "    * <<Write>> the guide",
     "    * <<Write>> the FAQ"
    ],
    "hits": 2
   }
  },
  {
   "name": "hit in a heading nests under its parent heading",
   "args": [
    "# Book\n\n## Chapter one\n\n### Winter\n\ntext\n\n### Spring\n\ntext\n",
    "spring"
   ],
   "expected": {
    "outline": [
     "- # Book",
     "  - ## Chapter one",
     "    * ### <<Spring>>"
    ],
    "hits": 1
   }
  },
  {
   "name": "a skipped heading level still nests",
   "args": [
    "# Top\n\n### Deep\n\n- item with needle\n",
    "needle"
   ],
   "expected": {
    "outline": [
     "- # Top",
     "  - ### Deep",
     "    * item with <<needle>>"
    ],
    "hits": 1
   }
  },
  {
   "name": "a new heading of the same level closes the old branch",
   "args": [
    "# A\n\n## One\n\nalpha\n\n## Two\n\nalpha again\n",
    "alpha"
   ],
   "expected": {
    "outline": [
     "- # A",
     "  - ## One",
     "    * <<alpha>>",
     "  - ## Two",
     "    * <<alpha>> again"
    ],
    "hits": 2
   }
  },
  {
   "name": "properties block is not searched",
   "args": [
    "---\ntitle: needle\n---\n# Note\n\nneedle in the body\n",
    "needle"
   ],
   "expected": {
    "outline": [
     "- # Note",
     "  * <<needle>> in the body"
    ],
    "hits": 1
   }
  },
  {
   "name": "match is case insensitive by default",
   "args": [
    "# Note\n\nThe QUICK fox\n",
    "quick"
   ],
   "expected": {
    "outline": [
     "- # Note",
     "  * The <<QUICK>> fox"
    ],
    "hits": 1
   }
  },
  {
   "name": "match case switch",
   "args": [
    "# Note\n\nThe QUICK fox\nthe quick dog\n",
    "quick",
    {
     "caseSensitive": true
    }
   ],
   "expected": {
    "outline": [
     "- # Note",
     "  * the <<quick>> dog"
    ],
    "hits": 1
   }
  },
  {
   "name": "a quoted phrase must match as one piece",
   "args": [
    "# Note\n\nred apple\napple red\n",
    "\"red apple\""
   ],
   "expected": {
    "outline": [
     "- # Note",
     "  * <<red apple>>"
    ],
    "hits": 1
   }
  },
  {
   "name": "every word must be on the same line",
   "args": [
    "# Note\n\nred apple pie\nred pie\napple\n",
    "apple red"
   ],
   "expected": {
    "outline": [
     "- # Note",
     "  * <<red>> <<apple>> pie"
    ],
    "hits": 1
   }
  },
  {
   "name": "regular expression",
   "args": [
    "# Log\n\n- error 404 at /a\n- ok 200 at /b\n- error 500 at /c\n",
    "error [45]0\\d",
    {
     "regex": true
    }
   ],
   "expected": {
    "outline": [
     "- # Log",
     "  * <<error 404>> at /a",
     "  * <<error 500>> at /c"
    ],
    "hits": 2
   }
  },
  {
   "name": "a bad regular expression gives an error and no hits",
   "args": [
    "# Log\n\ntext\n",
    "(",
    {
     "regex": true
    }
   ],
   "expected": {
    "outline": [],
    "hits": 0
   }
  },
  {
   "name": "lines in fenced code are not headings",
   "args": [
    "# Real\n\n```\n# not a heading\n```\n\nfind me\n",
    "find"
   ],
   "expected": {
    "outline": [
     "- # Real",
     "  * <<find>> me"
    ],
    "hits": 1
   }
  },
  {
   "name": "task marker is removed from the shown text",
   "args": [
    "# Todo\n\n- [ ] Buy milk\n  - [x] Oat milk\n",
    "oat"
   ],
   "expected": {
    "outline": [
     "- # Todo",
     "  - Buy milk",
     "    * <<Oat>> milk"
    ],
    "hits": 1
   }
  },
  {
   "name": "numbered list parents",
   "args": [
